# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# Read automatically by scripts/build_search_index.py and by each agent's
# main.py (python-dotenv, load_dotenv() -- walks up from the file that's
# running to find this .env, so one root-level .env covers all of them).
# The shell scripts in scripts/ read the same names as environment
# variables -- either `export` them from this file first
# (`set -a; source .env; set +a`) or pass them inline.
#
# Never commit your real .env -- it's gitignored.

# ---- Foundry project (required by every agent + build_search_index.py) ----
# Get this after infra/03-foundry-account.bicep deploys:
#   az cognitiveservices account show -g rg-foundryiq-v2 -n <account-name> --query properties.endpoints
FOUNDRY_PROJECT_ENDPOINT="https://<foundry-account>.services.ai.azure.com/api/projects/<project>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-4.1"

# ---- Azure AI Search + embeddings (required by build_search_index.py) ----
AZURE_SEARCH_ENDPOINT="https://<search-service>.search.windows.net"
AZURE_OPENAI_ENDPOINT="https://<foundry-account>.openai.azure.com/"
AZURE_EMBEDDING_MODEL_DEPLOYMENT_NAME="text-embedding-3-large"

# Names build_search_index.py creates/updates -- change only if you want
# different resource names in Search.
AZURE_SEARCH_INDEX_NAME="aw-docs-index"
AZURE_SEARCH_KNOWLEDGE_SOURCE_NAME="aw-docs-source"
AZURE_SEARCH_KNOWLEDGE_BASE_NAME="aw-knowledge-base"

# ---- PDF source for build_search_index.py ----
# Optional: PDFs ship in the repo at data/aw-docs/ and are picked up
# automatically. Only set this if your source PDFs live somewhere else.
# AW_PDF_DIR="/path/to/your/pdfs"

# ---- Azure resource identifiers (used as defaults by scripts/*.sh) ----
# Every script in scripts/ falls back to these values if the corresponding
# variable isn't set in your shell -- only needed if your resource names
# differ from the defaults baked into the scripts.
SUBSCRIPTION_ID="<your-subscription-id>"
RESOURCE_GROUP="rg-foundryiq-v2"
ACCOUNT_NAME="<foundry-account-name>"
PROJECT_NAME="<foundry-project-name>"
ACR_NAME="<acr-name>"
ACR_LOGIN_SERVER="<acr-name>.azurecr.io"

# Each script's own header comment documents any other optional overrides
# specific to that script (e.g. CONNECTION_NAME, TOOLBOX_NAME, CPU, MEMORY).
